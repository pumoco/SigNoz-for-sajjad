# Local development defaults only. Never commit the real .env.
PORT=8000
SIGNOZ_UI_BASE_URL=http://localhost:8000
# Services send OTLP to the collector's private/internal 4318 endpoint.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=service-name
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production
SIGNOZ_OTLP_HTTP_ENDPOINT=http://signoz:4318
SIGNOZ_ADMIN_USER=operator
SIGNOZ_ADMIN_PASSWORD=change-me-locally
